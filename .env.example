# Copy this file to .env and adjust as needed. No real secrets belong in this file or in .env
# committed to git (.env is gitignored).

# --- Postgres (used by docker-compose.yml and DATABASE_URL below) ---
POSTGRES_USER=officehours
POSTGRES_PASSWORD=officehours
POSTGRES_DB=officehours

# --- Orchestrator: database ---
# Inside docker compose this resolves via the "postgres" service hostname; from the host machine
# use localhost:5432 instead.
DATABASE_URL=postgresql://officehours:officehours@postgres:5432/officehours

# --- Orchestrator: model providers ---
# Ollama runs on the host, not in a container. The orchestrator container reaches it through the
# Docker-provided host.docker.internal hostname (see docker-compose.yml's extra_hosts entry).
#
# EMBED_PROVIDER and LLM_PROVIDER also accept "stub": a deterministic, network-free provider used
# only by the CI invariant gate (.github/workflows/eval.yml, EVAL_MODE=ci / `python -m eval.run
# --ci`). Never set this for local dev or production; see app/providers/llm.py::StubLLM and
# app/providers/embeddings.py::StubEmbedder.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5-8k:latest

# Read/request timeouts for the two Ollama calls. The local generator can take several minutes
# to respond to an advice-seeking question before it starts writing an answer, so this defaults
# well above httpx's 5s default. A short connect timeout (10s, not configurable here) still fails
# fast if Ollama itself is unreachable. Lower these for a hosted provider in production.
LLM_TIMEOUT_SECONDS=600.0
EMBED_TIMEOUT_SECONDS=180.0

# How long Ollama keeps the generator model loaded in memory after a request (Ollama's duration
# syntax, e.g. "60m" or "-1" to never unload). Sent on every request so back-to-back rows -- an eval
# run in particular -- do not each pay a cold-load cost.
OLLAMA_KEEP_ALIVE=60m

# Disables the reasoning model's thinking block, which otherwise consumes the whole output budget
# and yields an empty answer. Sent on every /api/chat request.
OLLAMA_THINK=false

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# --- Observability (grafana/otel-lgtm all-in-one container) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_SERVICE_NAME=office-hours-orchestrator

# --- Ingestion / crawling ---
# INGEST_MODE=fetch reads SOURCES_MANIFEST_PATH and fetches each URL live (the normal path).
# INGEST_MODE=snapshot skips the manifest and the network and chunks/embeds whatever *.md snapshot
# files are already sitting in RAW_SNAPSHOT_DIR -- used only by the CI invariant gate to ingest the
# small fixture corpus at eval/fixtures/sources. Never set this for local dev or production.
INGEST_MODE=fetch
CRAWL_DELAY_SECONDS=2.0
USER_AGENT=OfficeHoursBot/0.1 (+https://github.com/RishabhP1508/Office-Hours; contact: patel.rishabh@northeastern.edu)
GRAFANA_HOST_PORT=3001

JUDGE_PROVIDER=nvidia
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_API_KEY=your-key-here
JUDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# The NVIDIA judge endpoint's observed limit is roughly 40 requests/minute. Every judge call in an
# eval run -- eval/judge.py's own two judged tasks and every call RAGAS makes internally -- shares
# one rate limiter built from this single value (eval.judge.SHARED_RATE_LIMITER), so it must stay
# comfortably under the observed limit rather than track it closely.
JUDGE_REQUESTS_PER_MINUTE=20

# How many attempts eval/judge.py makes on a single judge call (score_comprehensibility,
# classify_refusal, judge_selfcheck) before giving up and recording that row as errored, on a 429,
# a 5xx, or a network timeout. Exponential backoff with jitter between attempts, capped per-sleep
# at about 60s.
JUDGE_MAX_RETRIES=12