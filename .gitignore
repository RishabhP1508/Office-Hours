# Secrets
.env
.env.*
!.env.example
!.env.local.example

# Eval run outputs (artifacts, not source)
eval/results/*
!eval/results/.gitkeep

# Crawled snapshots (regenerated by `python -m app.ingest`, not hand-authored source)
data/sources/raw/

# GGUF model weights (Phase 8 round 8): baked into the production image at build time from
# whoever's own local Ollama blob store (see README's deploy guide), never committed -- a 262MB
# binary has no business in git, and it is not this project's to redistribute. The directory
# itself IS tracked (services/orchestrator/models/.gitkeep) so Dockerfile's `COPY models ./models`
# always has something to copy.
services/orchestrator/models/*.gguf

# LangGraph checkpoint DB for the Phase 5 refresh job (regenerated by `python -m app.recrawl`)
data/refresh-checkpoints.sqlite
data/refresh-checkpoints.sqlite-*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / Next.js
node_modules/
.next/
services/frontend/out/
next-env.d.ts
.turbo/
*.tsbuildinfo

# Logs
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

docs/design/

.playwright-mcp/
*.png
!docs/**/*.png
docs/security/
