# Copy to .env.local for local development. NEXT_PUBLIC_ variables are baked into the client
# bundle at build time and are visible to anyone using the site -- never put a secret in one.

# Where the browser sends POST /v1/query, POST /v1/query/stream, and GET /v1/sources/status.
# Phase 7: this is the Go gateway (services/gateway), not the orchestrator directly -- the
# gateway is what rate limits, redacts PII out of the request body, and times upstream calls out.
# Replaces NEXT_PUBLIC_ORCHESTRATOR_URL (Phase 6, pointed straight at the orchestrator on 8000);
# that variable is retired, not kept alongside this one, so there is no ambiguity about which URL
# a given request actually used.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
