# Copy to .env.local for local development. NEXT_PUBLIC_ variables are baked into the client
# bundle at build time and are visible to anyone using the site -- never put a secret in one.

# Where the browser sends POST /query/stream and GET /sources/status. The frontend calls the
# orchestrator directly (there is no gateway in front of it until Phase 7).
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000
